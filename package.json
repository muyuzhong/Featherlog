{
  "name": "featherlog",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "dev": "pnpm --filter @featherlog/playground dev",
    "app": "pnpm --filter @featherlog/shell app",
    "build:app": "pnpm --filter @featherlog/shell build:app"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
