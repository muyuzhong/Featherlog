{
  "id": "quest",
  "name": "任务面板",
  "version": "0.1.0",
  "description": "任务日志：主线、支线与每日委托；追踪一个任务，逐个解锁目标。",
  "main": "src/main/index.ts",
  "ui": "src/ui/index.tsx",
  "emits": [
    "quest/created",
    "quest/updated",
    "quest/objective-completed",
    "quest/objective-reopened",
    "quest/chapter-completed",
    "quest/completed",
    "quest/uncompleted",
    "quest/counted",
    "quest/tracked",
    "quest/deleted",
    "quest/period-rolled"
  ],
  "listens": [
    "kernel/ready",
    "quest/created",
    "quest/updated",
    "quest/objective-completed",
    "quest/objective-reopened",
    "quest/chapter-completed",
    "quest/completed",
    "quest/uncompleted",
    "quest/counted",
    "quest/tracked",
    "quest/deleted",
    "quest/period-rolled",
    "scribe/said",
    "scribe/state-changed",
    "scribe/epilogue-written"
  ],
  "handles": [
    "quest/list",
    "quest/get",
    "quest/create",
    "quest/update",
    "quest/set-chapters",
    "quest/complete-objective",
    "quest/reopen-objective",
    "quest/count",
    "quest/complete",
    "quest/uncomplete",
    "quest/track",
    "quest/archive",
    "quest/delete",
    "quest/reorder"
  ],
  "requests": [
    "shell/set-badge",
    "shell/notify",
    "shell/open-panel",
    "scribe/state",
    "scribe/draft-quest",
    "scribe/split-objective",
    "scribe/lines",
    "scribe/epilogue"
  ],
  "contributes": {
    "collapsedIcons": [
      {
        "id": "quest/tracker",
        "title": "追踪中的任务",
        "icon": "scroll-text",
        "order": 0,
        "preview": true,
        "opens": "quest/journal"
      }
    ],
    "panelTabs": [
      {
        "id": "quest/journal",
        "title": "任务日志",
        "icon": "book-open",
        "order": 0
      }
    ],
    "settings": {
      "title": "任务",
      "schema": {
        "type": "object",
        "properties": {
          "dayStartHour": {
            "type": "integer",
            "title": "一天从几点开始",
            "description": "在这个时间之前完成的日常，算作前一天。",
            "minimum": 0,
            "maximum": 23,
            "default": 4
          }
        }
      }
    }
  }
}
