# Maintainer: muyuzhong (https://github.com/muyuzhong)
pkgname=featherlog-bin
pkgver=2.0.0
pkgrel=1
pkgdesc='Lightweight concurrent workbench panel, KDE Plasma 6 dock applet, and CLI hooks (羽记)'
arch=('x86_64')
url='https://github.com/muyuzhong/Featherlog'
license=('MIT')
depends=('glibc' 'gtk3' 'webkit2gtk-4.1' 'hicolor-icon-theme')
makedepends=('imagemagick')
optdepends=(
  'gtk-layer-shell: native Wayland overlay layer support'
  'plasma-workspace: KDE Plasma 6 bottom dock status bar applet'
  'qt6-tools: KDE Wayland KWin panel positioning via qdbus6'
)
provides=('featherlog')
conflicts=('featherlog')
options=('!strip' '!debug')
source=("featherlog-${pkgver}-linux-amd64.tar.gz::${url}/releases/download/v${pkgver}/featherlog-${pkgver}-linux-amd64.tar.gz"
        "LICENSE-${pkgver}::https://raw.githubusercontent.com/muyuzhong/Featherlog/v${pkgver}/LICENSE")
sha256sums=('5aaf7ee9b33927ac18a63cdc97ebe4e2072f2e5120e3c7699cd6d803c3cb7902'
            '869313596787f2dfd98d34c7c9d3c000f263bfe3b09162654de7aa1d054e3cda')

package() {
  local src="${srcdir}/featherlog-${pkgver}-linux-amd64"

  install -Dm755 "${src}/featherlog" "${pkgdir}/usr/bin/featherlog"
  install -Dm644 "${src}/featherlog.desktop" "${pkgdir}/usr/share/applications/featherlog.desktop"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  install -d "${pkgdir}/usr/share/plasma/plasmoids/io.github.muyuzhong.featherlog"
  cp -a "${src}/plasmoid/io.github.muyuzhong.featherlog/." \
    "${pkgdir}/usr/share/plasma/plasmoids/io.github.muyuzhong.featherlog/"
  find "${pkgdir}/usr/share/plasma/plasmoids/io.github.muyuzhong.featherlog" -type d -exec chmod 755 {} +
  find "${pkgdir}/usr/share/plasma/plasmoids/io.github.muyuzhong.featherlog" -type f -exec chmod 644 {} +

  for size in 16 24 32 48 64 128 256 512 1024; do
    install -d "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps"
    magick "${src}/icon.png" \
      -resize "${size}x${size}" \
      "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/featherlog.png"
  done
}
